# Postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/custody
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=password

# Fireblocks (do NOT commit real keys)
FIREBLOCKS_BASE_PATH=https://sandbox-api.fireblocks.io/v1
FIREBLOCKS_API_KEY=YOUR_SANDBOX_API_KEY_HERE
# FIREBLOCKS_SECRET_KEY may be an inline private key, or a path to a pem/key file stored securely.
FIREBLOCKS_SECRET_KEY=YOUR_SANDBOX_SECRET_KEY_OR_PATH_HERE
# Path to private key file (optional if using FIREBLOCKS_SECRET_KEY inline)
FIREBLOCKS_PRIVATE_KEY_PATH=/path/to/fireblocks_private_key.pem
# Webhook signing secret (used to validate incoming provider webhooks)
FIREBLOCKS_WEBHOOK_SIGNING_SECRET=YOUR_WEBHOOK_SIGNING_SECRET
# Optional: path to the Fireblocks webhook public key PEM for RSA verification
FIREBLOCKS_WEBHOOK_PUBLIC_KEY_PATH=/path/to/fireblocks_webhook_public.pem
# Verification method: HMAC_SHA256 or RSA_PEM
FIREBLOCKS_WEBHOOK_VERIFICATION_METHOD=HMAC_SHA256

# Azure Service Bus (optional local placeholder). Example for local emulator:
# Endpoint=sb://localhost/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=YOUR_KEY
AZURE_SERVICE_BUS_CONNECTION_STRING=

# Outbox queue name used for Service Bus
OUTBOX_QUEUE_NAME=outbox-events

# App
SPRING_PROFILES_ACTIVE=local
