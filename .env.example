# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/custody
SPRING_DATASOURCE_USERNAME=custody_app
SPRING_DATASOURCE_PASSWORD=changeme

# Fireblocks
FIREBLOCKS_BASE_PATH=http://localhost:9561
FIREBLOCKS_API_KEY=
# Path to a sandbox-only Fireblocks PEM key; do not commit the key itself.
FIREBLOCKS_SECRET_KEY=
FIREBLOCKS_WEBHOOK_PUBLIC_KEY=

# Local outbox processing is the default. The emulator is an optional profile.
MESSAGING_MODE=local
SERVICEBUS_CONNECTION_STRING=

# Local development bearer token (replace before sharing an environment).
LOCAL_JWT_TOKEN=local-dev-token

# App
PORT=8080
